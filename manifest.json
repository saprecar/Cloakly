{
  "manifest_version": 3,
  "name": "Cloakly",
  "version": "1.0.0",
  "description": "Local NSFW/Spoiler media blur protection and pre-submission subreddit requirement safety checker.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.reddit.com/*",
    "*://reddit.com/*",
    "*://*.reddittorjg6rue252oqsxryoxengawnmo46qy4kyii5wtqnwfj4ooad.onion/*",
    "*://reddittorjg6rue252oqsxryoxengawnmo46qy4kyii5wtqnwfj4ooad.onion/*",
    "*://*.reddittorjg6rue252oqsxryoxengawnmo46pou4wvlizvi5ywpuzzzid.onion/*",
    "*://reddittorjg6rue252oqsxryoxengawnmo46pou4wvlizvi5ywpuzzzid.onion/*"
  ],
  "background": {
    "scripts": [
      "utils/browser-api.js",
      "utils/storage.js",
      "utils/logger.js",
      "background/cleaner.js",
      "background/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "reddit-privacy-safety@local",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/*",
        "*://reddit.com/*",
        "*://*.reddittorjg6rue252oqsxryoxengawnmo46qy4kyii5wtqnwfj4ooad.onion/*",
        "*://reddittorjg6rue252oqsxryoxengawnmo46qy4kyii5wtqnwfj4ooad.onion/*",
        "*://*.reddittorjg6rue252oqsxryoxengawnmo46pou4wvlizvi5ywpuzzzid.onion/*",
        "*://reddittorjg6rue252oqsxryoxengawnmo46pou4wvlizvi5ywpuzzzid.onion/*"
      ],
      "js": [
        "content/blocker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.reddit.com/*",
        "*://reddit.com/*",
        "*://*.reddittorjg6rue252oqsxryoxengawnmo46qy4kyii5wtqnwfj4ooad.onion/*",
        "*://reddittorjg6rue252oqsxryoxengawnmo46qy4kyii5wtqnwfj4ooad.onion/*",
        "*://*.reddittorjg6rue252oqsxryoxengawnmo46pou4wvlizvi5ywpuzzzid.onion/*",
        "*://reddittorjg6rue252oqsxryoxengawnmo46pou4wvlizvi5ywpuzzzid.onion/*"
      ],
      "css": [
        "styles/blur.css",
        "styles/warning.css",
        "styles/scrolling-only.css",
        "styles/distractions.css"
      ],
      "js": [
        "utils/browser-api.js",
        "utils/logger.js",
        "utils/storage.js",
        "rules/rule-patterns.js",
        "rules/rule-engine.js",
        "content/detector.js",
        "content/ui.js",
        "content/blur.js",
        "content/filter.js",
        "content/scanner.js",
        "content/post-checker.js",
        "content/link-scanner.js",
        "content/reddit.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/auto-reveal.js"
      ],
      "matches": [
        "*://*.reddit.com/*",
        "*://reddit.com/*",
        "*://*.reddittorjg6rue252oqsxryoxengawnmo46qy4kyii5wtqnwfj4ooad.onion/*",
        "*://reddittorjg6rue252oqsxryoxengawnmo46qy4kyii5wtqnwfj4ooad.onion/*",
        "*://*.reddittorjg6rue252oqsxryoxengawnmo46pou4wvlizvi5ywpuzzzid.onion/*",
        "*://reddittorjg6rue252oqsxryoxengawnmo46pou4wvlizvi5ywpuzzzid.onion/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cloakly Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html"
}
